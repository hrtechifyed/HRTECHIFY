{
  "ci": {
    "collect": {"staticDistDir": ".", "url": ["http://localhost/index.html", "http://localhost/products.html", "http://localhost/about.html", "http://localhost/contact.html"]},
    "assert": {"assertions": {"categories:performance": ["warn", {"minScore": 0.9}], "categories:accessibility": ["error", {"minScore": 0.95}], "categories:seo": ["error", {"minScore": 0.95}], "categories:best-practices": ["warn", {"minScore": 0.9}]}},
    "upload": {"target": "temporary-public-storage"}
  }
}
